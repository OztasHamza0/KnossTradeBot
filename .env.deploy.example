# ============================================================
#  Sunucudaki dosya adi: .env.deploy
#  docker compose bu dosyayi okur:
#      docker compose --env-file .env.deploy up -d --build
# ============================================================

# ---- ALAN ADI ----
# Telegram SADECE HTTPS kabul eder, ham IP adresi kabul ETMEZ.
# Ucretsiz alan adi icin: https://www.duckdns.org (ornek: hamzabot.duckdns.org)
# Bu alan adi sunucunun public IP'sine yonlendirilmis olmali.
DOMAIN=hamzabot.duckdns.org

# Let's Encrypt sertifika uyarilarinin gidecegi e-posta
ACME_EMAIL=seninmailin@ornek.com

# ---- VERITABANI ----
# Bu makinede calisan Postgres. Sifreyi degistir:
#   openssl rand -base64 24
POSTGRES_USER=tradingbot
POSTGRES_PASSWORD=BURAYA_UZUN_RASTGELE_SIFRE
POSTGRES_DB=tradingbot

# ---- BOT ----
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ABACUSAI_API_KEY=s2_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rastgele uzun degerler uret:
#   openssl rand -hex 32
CRON_API_KEY=BURAYA_RASTGELE_DEGER
TELEGRAM_WEBHOOK_SECRET=BURAYA_RASTGELE_DEGER

# Karar modeli. Daha ucuz/hizli alternatif: claude-sonnet-4-6
LLM_MODEL=claude-fable-5
