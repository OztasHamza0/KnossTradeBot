generator client {
    provider = "prisma-client-js"
    // No custom `output`: the default (node_modules/.prisma/client) resolves wherever
    // the project is checked out. A hardcoded absolute path breaks on every machine
    // but the one it was generated on.
    // Targets cover glibc and musl (Alpine) on both x64 and arm64.
    binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model chat_history {
  id         Int      @id @default(autoincrement())
  chat_id    String
  role       String // 'user' | 'assistant'
  content    String
  created_at DateTime @default(now())

  @@index([chat_id, created_at])
}

model user_instructions {
  id          Int      @id @default(autoincrement())
  chat_id     String
  instruction String
  created_at  DateTime @default(now())

  @@index([chat_id])
}

/// Gonderilen kartlar ve SONUCLARI.
///
/// Once yalnizca kartin kendisi kaydediliyordu; ne oldugu hic olculmuyordu.
/// Bu yuzden "bot ise yariyor mu" sorusunun olculebilir bir cevabi yoktu ve
/// bot aylarca zarar ettiriyor olsa veride bunu gosterecek hicbir sey olmazdi.
model sent_signals {
  id          Int      @id @default(autoincrement())
  chat_id     String
  pair        String
  direction   String
  entry_price Float
  /// Sonuc olcumu icin gerekli: kart gonderildigi andaki stop ve hedef.
  stop_loss   Float?
  take_profit Float?
  leverage    Float?
  /// open | tp | sl | expired | unknown
  status      String   @default("open")
  /// Sonucun olculdugu an ve fiyat.
  closed_at   DateTime?
  closed_price Float?
  created_at  DateTime @default(now())

  @@index([chat_id, pair, direction, created_at])
  @@index([status, created_at])
}

model active_chats {
  id         Int      @id @default(autoincrement())
  chat_id    String   @unique
  created_at DateTime @default(now())
}

/// Per-chat balance and auto-scan schedule.
model user_state {
  id           Int      @id @default(autoincrement())
  chat_id      String   @unique
  /// Kill switch girdisi. Null = kullanici henuz bildirmedi.
  balance_usdt Float?
  /// Otomatik nobet araligi (dakika). Kullanici Telegram'dan degistirir.
  scan_interval_minutes Int @default(60)
  /// "nobet kapat" ile false olur; aralik korunur.
  scan_enabled Boolean @default(true)
  /// Son otomatik tarama zamani — sirada olup olmadigi buradan hesaplanir.
  last_scan_at DateTime?
  /// Sessiz saat araligi (yerel saat, 0-23). Null ise sessiz saat yok.
  /// quiet_start > quiet_end ise aralik gece yarisini asar (orn 23-07).
  quiet_start  Int?
  quiet_end    Int?
  updated_at   DateTime @default(now()) @updatedAt
}
