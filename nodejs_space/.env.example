# ---- ZORUNLU ----

# @BotFather'dan aldigin token
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL baglanti adresi
DATABASE_URL=postgresql://kullanici:sifre@host:5432/veritabani?connect_timeout=15

# Abacus AI API anahtari (https://apps.abacus.ai)
ABACUSAI_API_KEY=s2_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Uygulamanin canli HTTPS adresi. Bot acilista Telegram webhook'unu
# buraya kaydeder. BOS BIRAKILIRSA TELEGRAM MESAJLARI GELMEZ.
# Sonunda / olmasin.
PUBLIC_URL=https://senin-adresin.example.com

# ---- ONERILEN ----

# /auto-scan/execute endpoint'ini korur (x-api-key header'i).
# Dis cron kullanmiyorsan bile rastgele bir deger koy.
CRON_API_KEY=rastgele-uzun-bir-deger-uret

# Telegram webhook'unu dogrular. Ayarlanirsa bot bunu setWebhook'a gonderir
# ve gelen her istekte kontrol eder. Webhook adresin acik oldugu icin onerilir.
TELEGRAM_WEBHOOK_SECRET=rastgele-uzun-bir-deger-uret

# CoinGecko ucretsiz Demo API anahtari.
# https://www.coingecko.com/en/developers/dashboard -> Create Demo Account
# Kart istemiyor. Aylik 10.000 cagri, dakikada ~100 istek.
#
# ANAHTARSIZ kota IP basinadir. Render gibi paylasimli barindirmada o IP'yi
# baska kiracilar da kullandigi icin kota surekli dolu olur ve "arastir"
# komutu her seferinde 429 alir. Anahtar kotayi IP'den anahtara tasir.
COINGECKO_API_KEY=CG-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- OPSIYONEL ----

# ---- LLM SAGLAYICISI ----
# callLLM OpenAI-uyumlu chat/completions formati konusur; Abacus, Gemini'nin
# uyumluluk katmani, Groq ve OpenRouter ayni formati kabul eder. Kota biterse
# asagidaki uc degiskeni degistirmek yeterli, kod degismez.
# Ayrintili gecis rehberi: KOTA_BITERSE.md

# Varsayilan: https://apps.abacus.ai/v1/chat/completions
# LLM_API_URL=

# Tanimli degilse ABACUSAI_API_KEY kullanilir (geriye donuk uyumluluk).
# LLM_API_KEY=

# Karar modeli. Varsayilan: claude-fable-5
# Daha ucuz/hizli alternatif: claude-sonnet-4-6
LLM_MODEL=claude-fable-5

# Cevap uzunlugu tavani. Fable dusunurken de token harcar, 2000'in altina inme.
# LLM_MAX_TOKENS=4000

# Prompt'a giren coin sayisi (5-50). Dusurmek input token maliyetini dogrudan azaltir.
# PROMPT_COIN_COUNT=50

# Dahili saatlik cron'u kapatir. Sadece platformun kendi cron'unu
# /auto-scan/execute uzerinden kullanacaksan "true" yap.
DISABLE_INTERNAL_CRON=false

# Sunucu portu. Cogu platform bunu kendisi enjekte eder, elle ayarlama.
# PORT=3000
