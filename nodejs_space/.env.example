# ---- ZORUNLU ----

# @BotFather'dan aldigin token
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL baglanti adresi
DATABASE_URL=postgresql://kullanici:sifre@host:5432/veritabani?connect_timeout=15

# Abacus AI API anahtari (https://apps.abacus.ai)
ABACUSAI_API_KEY=s2_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Uygulamanin canli HTTPS adresi. Bot acilista Telegram webhook'unu
# buraya kaydeder. BOS BIRAKILIRSA TELEGRAM MESAJLARI GELMEZ.
# Sonunda / olmasin.
PUBLIC_URL=https://senin-adresin.example.com

# Botun hizmet verecegi Telegram sohbet id'leri (virgulle ayrilmis).
# BOS BIRAKILIRSA HERKESE ACIK: botun adresini bulan herkes active_chats'e
# eklenir ve saatlik nobette SENIN LLM kotandan tarama alir.
# Kendi id'ni ogrenmek icin bota /start yazip loglara bak.
# ALLOWED_CHAT_IDS=123456789

# ---- ONERILEN ----

# /auto-scan/execute endpoint'ini korur (x-api-key header'i).
# Dis cron kullanmiyorsan bile rastgele bir deger koy.
CRON_API_KEY=rastgele-uzun-bir-deger-uret

# Telegram webhook'unu dogrular. Ayarlanirsa bot bunu setWebhook'a gonderir
# ve gelen her istekte kontrol eder. Webhook adresin acik oldugu icin onerilir.
TELEGRAM_WEBHOOK_SECRET=rastgele-uzun-bir-deger-uret

# CoinGecko ucretsiz Demo API anahtari.
# https://www.coingecko.com/en/developers/dashboard -> Create Demo Account
# Kart istemiyor. Aylik 10.000 cagri, dakikada ~100 istek.
#
# ANAHTARSIZ kota IP basinadir. Render gibi paylasimli barindirmada o IP'yi
# baska kiracilar da kullandigi icin kota surekli dolu olur ve "arastir"
# komutu her seferinde 429 alir. Anahtar kotayi IP'den anahtara tasir.
COINGECKO_API_KEY=CG-xxxxxxxxxxxxxxxxxxxxxxxx

# Bot saati (sessiz saat hesabi bunu kullanir). Varsayilan: Europe/Istanbul
# BOT_TIMEZONE=Europe/Istanbul

# ---- OPSIYONEL ----

# ---- LLM SAGLAYICISI ----
# callLLM OpenAI-uyumlu chat/completions formati konusur; Abacus, Gemini'nin
# uyumluluk katmani, Groq ve OpenRouter ayni formati kabul eder. Kota biterse
# asagidaki uc degiskeni degistirmek yeterli, kod degismez.
# Ayrintili gecis rehberi: KOTA_BITERSE.md

# Varsayilan: https://apps.abacus.ai/v1/chat/completions
# LLM_API_URL=

# Tanimli degilse ABACUSAI_API_KEY kullanilir (geriye donuk uyumluluk).
# LLM_API_KEY=

# KARAR modeli: elle "tara"/"arastir", ekran goruntusu analizi ve nobet
# sinyallerinin ikinci degerlendirmesi bunu kullanir.
LLM_MODEL=claude-fable-5

# NOBET modeli (opsiyonel): saatlik taramalari bu ucuz model yapar.
# Taramalarin buyuk cogunlugu "firsat yok" ile bitiyor; oraya pahali model
# harcamanin karsiligi yok. Bir sinyal cikarsa LLM_MODEL devreye girip
# onaylar, duzeltir ya da reddeder — yani senin gordugun her kart karar
# modelinden gecmis olur.
#
# Tanimli DEGILSE ayrim kapanir, her sey LLM_MODEL ile calisir.
# LLM_MODEL_WATCH=anthropic/claude-haiku-4.5

# Cevap uzunlugu tavani. Dusunen modeller (fable, opus) dusunurken de token
# harcar, 2000'in altina inme.
# DIKKAT: OpenRouter bu deger kadar krediyi PESIN bloke eder — bakiye
# gercekten bitmeden "402 kredi yetersiz" alabilirsin.
# LLM_MAX_TOKENS=4000

# Dusunme derinligi (OpenRouter'in `reasoning` parametresi).
# Dusunme token'lari CIKTI fiyatindan faturalanir ve dusunen bir modelde
# faturanin buyuk kismini olusturur: olculen bir "tara" 10 sent, bunun
# ~8 senti dusunme.
#
# Bu gorevde (tablo oku, kurallari uygula, JSON uret) derin muhakeme
# gerekmiyor; "low" ciddi tasarruf saglar.
# Degerler: minimal, low, medium, high, xhigh, max
# Bos birakilirsa parametre hic gonderilmez (saglayici tanimiyorsa guvenli).
# LLM_REASONING_EFFORT=low

# Prompt'a giren coin sayisi (5-50). Dusurmek input token maliyetini dogrudan azaltir.
# PROMPT_COIN_COUNT=50

# Dahili saatlik cron'u kapatir. Sadece platformun kendi cron'unu
# /auto-scan/execute uzerinden kullanacaksan "true" yap.
DISABLE_INTERNAL_CRON=false

# Sunucu portu. Cogu platform bunu kendisi enjekte eder, elle ayarlama.
# PORT=3000

# Model sicakligi. BILEREK opt-in: dusunme modu (LLM_REASONING_EFFORT)
# acikken saglayici temperature=1 disinda bir deger kabul etmiyor, sabit
# bir deger gondermek cagriyi 400 ile dusururdu.
# Dusunmeyi kapatip tekrarlanabilirlik istiyorsan 0.2 civari ver.
# LLM_TEMPERATURE=0.2

# Ikinci degerlendirme katmanini kapatir.
# Varsayilan (bos/false): nobetin urettigi HER kart, kullaniciya gitmeden
# once karar modeli tarafindan denetlenir. LLM_MODEL_WATCH tanimli olmasa
# bile calisir — denetci prompt'u fonlama/acik pozisyon/long-short verisini
# goruyor, tarama passi bunlari hic gormuyor, yani ayni model olsa da yeni
# bilgiyle ikinci bakis oluyor. Yalnizca kart uretilen gecislerde kosar.
# DISABLE_SIGNAL_REVIEW=false
